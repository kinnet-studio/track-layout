{
    "compilerOptions": {
        "declaration": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["bun"]
    },
    "include": ["src", "test", "scripts"]
}
